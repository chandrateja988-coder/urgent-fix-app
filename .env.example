# Copy this file to ".env" and fill in your own values.
# ".env" is listed in .gitignore, so your real key never reaches GitHub.
# On Vercel, add these same two names under Project Settings -> Environment Variables.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-secret-key

# Optional: a long random string used to sign login sessions.
# If you leave it out, a signing key is derived from SUPABASE_SERVICE_KEY.
# SESSION_SECRET=
